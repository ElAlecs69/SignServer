# ==========================================
# CONFIGURACIÓN GENERAL Y SECRETOS
# ==========================================
SIGNSERVER_IP=192.168.1.100
PUBLIC_DOMAIN=ejemplo.com
APP_PUBLIC_URL=https://ejemplo.com
OIDC_REDIRECT_URI=https://ejemplo.com/auth/callback

# Importante: Reemplaza estas dos claves ejecutando "openssl rand -hex 32" en tu terminal
SECRET_KEY=tu_secret_key_generado_aqui
SESSION_SECRET=tu_session_secret_generado_aqui

# ==========================================
# PROVEEDOR DE IDENTIDAD (MICROSOFT ENTRA ID)
# ==========================================
# Reemplaza con los valores reales de tu Azure App Registration
OIDC_CLIENT_ID=tu-client-id-aqui
OIDC_CLIENT_SECRET=tu-client-secret-aqui
OIDC_SERVER_METADATA_URL=https://login.microsoftonline.com/tu-tenant-id/v2.0/.well-known/openid-configuration

# Roles por correo electrónico
ADMIN_EMAILS=admin@tudominio.com
AUDITOR_EMAILS=auditor@tudominio.com

# ==========================================
# BASE DE DATOS NEGOCIO (POSTGRESQL - document-api)
# ==========================================
BUSINESS_DB_NAME=signserver_business
BUSINESS_DB_USER=signserver_app
BUSINESS_DB_PASSWORD=tu_password_seguro_postgres

# ==========================================
# BASE DE DATOS SIGNSERVER (MARIADB)
# ==========================================
MYSQL_DATABASE=signserver
MYSQL_USER=signserver_user
MYSQL_PASSWORD=tu_password_seguro_mariadb
MYSQL_ROOT_PASSWORD=tu_password_seguro_root
